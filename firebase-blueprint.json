{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Tournament data",
      "type": "object",
      "properties": {}
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Wallet transaction",
      "type": "object",
      "properties": {}
    },
    "Message": {
      "title": "Message",
      "description": "User to Admin live chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "senderId", "senderName", "receiverId", "text", "timestamp", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Users collection"
    },
    "/tournaments/{tournamentId}": {
      "schema": { "$ref": "#/entities/Tournament" },
      "description": "Tournaments collection"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Transactions collection"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Real-time user-to-admin messages collection"
    }
  }
}
